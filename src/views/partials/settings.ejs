<dialog id="panel-settings" aria-labelledby="settings-title">
  <div class="dialog-header"><h2 id="settings-title">Paths &amp; setup</h2><button class="icon-button" id="close-settings-popup" aria-label="Close settings">×</button></div>
  <div class="settings-fields">
    <%- include('path-field', {id:'s-cli',label:'truckersmp-cli',folder:false}) %>
    <div id="cx-paths">
      <%- include('path-field', {id:'s-wine',label:'CrossOver Wine executable',folder:false}) %>
      <%- include('path-field', {id:'s-bottle',label:'Bottle',folder:true}) %>
      <%- include('path-field', {id:'s-steam',label:'Steam folder',folder:true}) %>
      <%- include('path-field', {id:'s-game',label:'ETS2 folder',folder:true}) %>
      <%- include('path-field', {id:'s-ats',label:'ATS folder',folder:true}) %>
    </div>
    <div id="wm-standalone-paths" class="hidden">
      <%- include('path-field', {id:'sw-bottle-path',label:'Bottle',folder:true}) %>
      <%- include('path-field', {id:'sw-steam-dir',label:'Steam folder',folder:true}) %>
      <%- include('path-field', {id:'sw-game-dir',label:'ETS2 folder',folder:true}) %>
      <%- include('path-field', {id:'sw-ats-dir',label:'ATS folder',folder:true}) %>
      <div class="setup-status">
        <span><span id="sw-ind-wine">○</span> <span id="sw-lbl-wine">Wine 11.11</span></span>
        <span><span id="sw-ind-bottle">○</span> <span id="sw-lbl-bottle">Bottle</span></span>
        <span><span id="sw-ind-dxmt">○</span> <span id="sw-lbl-dxmt">DXMT</span></span>
      </div>
      <button class="button-secondary" id="btn-open-sw-wizard">Open setup wizard</button>
    </div>
  </div>
  <div class="dialog-actions"><button class="button-primary" id="btn-save">Save paths</button></div>
</dialog>
